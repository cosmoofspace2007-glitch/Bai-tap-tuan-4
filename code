import numpy as np
import pandas as pd

col = "PM10"

Q1 = df[col].quantile(0.25)
Q3 = df[col].quantile(0.75)
IQR = Q3 - Q1
lower_bound_iqr = Q1 - 1.5 * IQR
upper_bound_iqr = Q3 + 1.5 * IQR
outliers_iqr = df[
    (df[col] < lower_bound_iqr) | (df[col] > upper_bound_iqr)
]
print(f"Số lượng ngoại lệ theo IQR: {len(outliers_iqr)}")

z_scores = np.abs((df[col] - df[col].mean()) / df[col].std())
outliers_z = df[z_scores > 3]
print(f"Số lượng ngoại lệ theo Z-Score (threshold > 3): {len(outliers_z)}")

print(f"Số dòng bị flag bởi cả hai phương pháp:")
common_outliers = pd.merge(outliers_iqr, outliers_z, how="inner")
print(len(common_outliers))

